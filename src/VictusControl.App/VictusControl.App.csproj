<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VictusControl.Core\VictusControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <Content Include="Assets\Network\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Composition hosting uses Windows Graphics Capture / WinRT. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (the tray icon) lives in WinForms; there is no WPF equivalent -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>victus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="victus.ico" />
  </ItemGroup>

  <!-- UseWindowsForms adds these as global usings, which makes Button, Brush,
       UserControl and Application ambiguous against their WPF namesakes.
       TrayPresence.cs imports them explicitly instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
