<Window x:Class="VictusControl.App.QuickControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Victus quick controls" Width="390" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" FontFamily="{StaticResource BodyFace}"
        UseLayoutRounding="True" WindowStartupLocation="Manual">
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Stroke}"
            BorderThickness="1" CornerRadius="14" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButton}"
                        AutomationProperties.Name="Dismiss quick controls" Click="OnDismiss"/>
                <StackPanel>
                    <TextBlock Text="VICTUS CONTROL" Style="{StaticResource CardTitle}" FontSize="17"/>
                    <TextBlock Text="Quick controls" Style="{StaticResource LabelMuted}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource CardTitle}" Foreground="{DynamicResource AccentA}"/>
                        <TextBlock x:Name="CpuReading" Text="—" Style="{StaticResource StatBig}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="CpuDetail" Text="Waiting for telemetry" Style="{StaticResource LabelMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="GPU" Style="{StaticResource CardTitle}" Foreground="{DynamicResource AccentB}"/>
                        <TextBlock x:Name="GpuReading" Text="—" Style="{StaticResource StatBig}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="GpuDetail" Text="Waiting for telemetry" Style="{StaticResource LabelMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="SessionText" Text="No game session active" Style="{StaticResource LabelMuted}" Margin="0,12,0,18"/>
            <TextBlock Text="FAN MODE" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
            <UniformGrid x:Name="FanModes" Columns="2">
                <Button Content="Default" Tag="Default" Style="{StaticResource GhostButton}" Margin="0,0,5,8" Click="OnFanMode"/>
                <Button Content="Performance" Tag="Performance" Style="{StaticResource GhostButton}" Margin="5,0,0,8" Click="OnFanMode"/>
                <Button Content="Cool" Tag="Cool" Style="{StaticResource GhostButton}" Margin="0,0,5,0" Click="OnFanMode"/>
                <Button Content="Quiet" Tag="Quiet" Style="{StaticResource GhostButton}" Margin="5,0,0,0" Click="OnFanMode"/>
            </UniformGrid>
            <Button x:Name="MaxFanAction" Content="Max fans · checking…" Style="{StaticResource GhostButton}"
                    Margin="0,12,0,0" Click="OnMaxFan"/>
            <TextBlock x:Name="CommandStatus" Text="Ready" Style="{StaticResource LabelMuted}" Margin="0,12,0,14"/>
            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,14"/>
            <DockPanel Margin="0,0,0,14">
                <TextBlock Text="Light theme" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                <ToggleButton x:Name="LightSwitch" Style="{StaticResource ThemeToggle}" HorizontalAlignment="Right"
                              AutomationProperties.Name="Light theme" Click="OnTheme"/>
            </DockPanel>
            <UniformGrid Columns="2">
                <Button Content="Dashboard ↗" Style="{StaticResource GhostButton}" Margin="0,0,5,0" Click="OnDashboard"/>
                <Button Content="History ↗" Style="{StaticResource GhostButton}" Margin="5,0,0,0" Click="OnHistory"/>
            </UniformGrid>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
